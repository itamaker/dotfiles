# Move focus between splits
{{- if eq .chezmoi.os "darwin" }}
# macOS: Cmd+Option+arrows
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_down=goto_split:down
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
{{- else }}
# Linux: Ctrl+Shift+arrows (GNOME already uses Ctrl+Alt+arrows for workspaces)
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_down=goto_split:down
keybind = ctrl+shift+arrow_left=goto_split:left
keybind = ctrl+shift+arrow_right=goto_split:right
{{- end }}
